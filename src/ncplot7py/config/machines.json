          "g_codes": ["G255", "G266"],
          "program_control": ["M0", "M1", "M3", "M5", "M30"]
        }
      }
    },
    "control_type": "FANUC",
    "parser_name": "fanuc",
    "lexer_name": "fanuc",
    "machine_type": "MILL",
    "channels": 1,
    "axes": ["X", "Y", "Z", "B", "C"],
