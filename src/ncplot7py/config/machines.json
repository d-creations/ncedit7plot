        "token": "string.quoted.double",
        "regex": "\"[^\"]*\""
      },
      {
        "token": "keyword.control",
        "regex": "\\b(?:GOTO|IF|WHILE|DO|END)\\b"
      },
      {
        "token": "support.function",
        "regex": "\\b(?:SQRT|ASIN|ACOS|ATAN|SIN|COS|TAN|ABS|BIN|BCD|ROUND|FIX|FUP)\\b"
