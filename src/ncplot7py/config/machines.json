        "regex": "[Gg]\\s*\\d+(?:\\.\\d+)?"
      },
      {
        "token": "constant.language.mcode",
        "regex": "[Mm]\\s*\\d+(?:\\.\\d+)?"
      },
      {
        "token": [
          "entity.name.tag",
          "constant.numeric"
        ],
        "regex": "([A-Z])(\\s*[+-]?\\d+(?:\\.\\d+)?)"
      }
    ],
